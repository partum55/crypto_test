# Free Demo key from https://www.coingecko.com/en/api/pricing (required in practice;
# keyless access is rate-limited after a few calls).
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

CACHE_TTL_SECONDS=300
DETAIL_CACHE_TTL_SECONDS=3600
MAX_PAGES=12
CONCURRENCY=5
MIN_REQUEST_INTERVAL=0.67
MAX_RETRIES=4
REQUEST_TIMEOUT=15
